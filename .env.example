# Bot token from @BotFather
BOT_TOKEN=

# Required: only this Telegram user can use the bot (numeric user ID, not username)
OWNER_USER_ID=

# OpenAI API key and model for AI conversations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Group name-addressing checks use OpenAI Decisions with the same key.
OPENAI_DECISION_MODEL=gpt-6-luna

# Optional local timezone for dates sent to the AI
BOT_TIMEZONE=Europe/Moscow

# Optional SQLite database path, relative to the current directory
DATABASE_PATH=var/agent/dashulya.sqlite3

# Optional log file path; logs rotate at 10 MiB with 5 backups
LOG_PATH=var/logs/dashulya.log

# Required matching evidence index and completed OpenViking import
MEMORY_PATH=var/agent/evidence.sqlite3
LIVE_MEMORY_PATH=var/agent/memory.sqlite3
OPENVIKING_URL=http://127.0.0.1:1933
OPENVIKING_MANIFEST=var/agent/import/manifest.json
# Compose requires a shared local service key; generate it with openssl rand -hex 32
OPENVIKING_API_KEY=
# Optional published host port; keep OPENVIKING_URL aligned if changed
OPENVIKING_PORT=1933
