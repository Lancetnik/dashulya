# Bot token from @BotFather
BOT_TOKEN=

# Required: only this Telegram user can use the bot (numeric user ID, not username)
OWNER_USER_ID=

# OpenAI API key and model for AI conversations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Group name-addressing checks use OpenAI Decisions with the same key.
OPENAI_DECISION_MODEL=gpt-6-luna

# Optional local timezone for dates sent to the AI
BOT_TIMEZONE=Europe/Moscow

# Optional SQLite database path, relative to the current directory
DATABASE_PATH=var/agent/dashulya.sqlite3

# Optional log file path; logs rotate at 10 MiB with 5 backups
LOG_PATH=var/logs/dashulya.log

# Optional imported SQLite evidence for local Python runs; absence starts with live memory
MEMORY_PATH=var/agent/evidence.sqlite3
# Compose mounts this host directory read-only at /memory and reads evidence.sqlite3
# For a custom former MEMORY_PATH, set this to its parent; name the index evidence.sqlite3
MEMORY_DIRECTORY=./var/agent
# Optional trusted numeric Telegram chat binding for the imported archive.
# Leave empty to expose the archive only in the owner's private conversation.
MEMORY_IMPORT_CHAT_ID=
# Local Python paths; Compose persists these under its /var/lib/dashulya mount
LIVE_MEMORY_PATH=var/agent/memory.sqlite3
MEMORY_VECTORS_PATH=var/agent/vectors.sqlite3

# Optional legacy OpenViking maintenance only; not required by the agent
OPENVIKING_URL=http://127.0.0.1:1933
OPENVIKING_MANIFEST=var/agent/import/manifest.json
# The optional OpenViking service requires a key; generate with openssl rand -hex 32
OPENVIKING_API_KEY=
# Optional published host port; keep OPENVIKING_URL aligned if changed
OPENVIKING_PORT=1933
